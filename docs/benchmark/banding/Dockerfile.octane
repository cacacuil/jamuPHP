# Laravel Octane di belakang Caddy: aplikasi dimuat sekali, dan tiap pekerja PHP adalah
# proses sendiri. Dasarnya image aplikasi di atas jamuphp, jadi PHP dan Caddy-nya sama.
ARG DASAR
FROM ghcr.io/roadrunner-server/roadrunner:2025.1 AS rr
FROM ${DASAR}
ARG MESIN
USER root
COPY --from=rr /usr/bin/rr /usr/local/bin/rr
# Octane sendiri butuh pcntl (sinyal). Swoole adalah extension PHP; RoadRunner adalah program
# terpisah yang butuh extension sockets.
RUN if [ "$MESIN" = swoole ]; then install-php-extensions pcntl swoole; else install-php-extensions pcntl sockets; fi
# Octane berjalan di PHP baris perintah, yang bawaannya tanpa opcache.
RUN echo 'opcache.enable_cli=1' > "$PHP_INI_DIR/conf.d/zz-octane.ini"
USER www-data
ENV MESIN=${MESIN}
HEALTHCHECK NONE
ENTRYPOINT ["/bin/sh", "/banding/mulai-octane.sh"]
CMD []
